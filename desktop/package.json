{
  "name": "@opendesk/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "opendesk for macOS, Windows and Linux",
  "homepage": "https://opendesk.sh",
  "type": "module",
  "author": {
    "name": "opendesk",
    "email": "team@opendesk.sh"
  },
  "main": "dist/main.cjs",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && electron . --dev",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist": "node scripts/build.mjs && electron-builder --config electron-builder.config.cjs --publish never",
    "release": "node scripts/build.mjs && electron-builder --config electron-builder.config.cjs --publish always",
    "icons": "electron scripts/icons.cjs",
    "package:dir": "node scripts/build.mjs && electron-builder --config electron-builder.config.cjs --dir --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@types/node": "^26.6.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "~7.0.2",
    "vitest": "^5.0.4"
  }
}
