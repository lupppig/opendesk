{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/qa/hooks/pretool.ts\"; [ -f \"$f\" ] || exit 0; exec node \"$f\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
