# opendesk configuration. Copy to .env for local development.
OPENDESK_ENV=development
OPENDESK_ROLE=all
HTTP_ADDR=:8080
DATA_DIR=./data
API_URL=http://localhost:8080
APP_URL=http://localhost:5173
GATEWAY_URL=ws://localhost:4000/socket
CORS_ORIGINS=http://localhost:5173

# Postgres. Behind a pooler (PgBouncer, a provider's pooled host), DATABASE_URL is the pooled
# connection and DATABASE_URL_DIRECT the direct one.
DATABASE_URL=postgres://opendesk:opendesk@localhost:55432/opendesk?sslmode=disable
DATABASE_URL_DIRECT=

# Help centers (contracts/teams.md "Help center addresses"). HELP_DOMAIN puts each brand's
# help center at <slug>.HELP_DOMAIN; empty keeps it at APP_URL/help/<slug>.
HELP_DOMAIN=
# What custom domains CNAME to. Empty: custom.HELP_DOMAIN with Cloudflare for SaaS, else
# the host of APP_URL.
HELP_CNAME_TARGET=
# Shared with an edge proxy in front of help centers (deploy/cloudflare/help-worker), at
# least 32 bytes. When set, only requests that carry it name a help center host.
HELP_PROXY_SECRET=
# Cloudflare for SaaS: custom domains become custom hostnames of this zone. Both or
# neither; the token needs SSL and Certificates edit on that zone only. Without them the
# instance's own proxy issues certificates (Caddy on-demand TLS).
CLOUDFLARE_SAAS_ZONE_ID=
CLOUDFLARE_SAAS_TOKEN=

# At least 32 bytes. Shared with the realtime gateway.
AUTH_SECRET=
# 32 bytes, hex or base64. Encrypts mailbox credentials and webhook secrets.
CREDENTIALS_KEY=
# Keys CREDENTIALS_KEY replaced, comma separated: they still decrypt, and stored values
# are encrypted again with CREDENTIALS_KEY (docs: self-hosting/hardening).
CREDENTIALS_KEY_PREVIOUS=

# Empty = NATS runs embedded in this process (listening on NATS_LISTEN for the gateway).
NATS_URL=
NATS_TOKEN=
NATS_LISTEN=127.0.0.1:4222

STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Platform email (verification, resets, invites): log | smtp | ses
MAIL_DRIVER=log
MAIL_FROM=opendesk <notifications@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=starttls
SES_REGION=us-east-1

# Notification email pacing. NOTIFY_EMAIL_PACING picks the defaults: strict (the default
# when billing is on: first email after 5m, then at most one every 15m, 30m, 1h; 4 an
# hour, 24 a day) or relaxed (self-hosted: 5m, 15m, 30m, 1h; 12 an hour, 100 a day).
# Urgent ones (mentions, missed SLAs, handoffs, billing problems) may come sooner.
# NOTIFY_EMAIL_PACING=relaxed
# NOTIFY_EMAIL_DELAY=5m
# NOTIFY_EMAIL_COOLDOWNS=5m,15m,30m,1h
# NOTIFY_EMAIL_QUIET_RESET=2h
# NOTIFY_EMAIL_URGENT_GAP=5m
# NOTIFY_EMAIL_URGENT_PER_DAY=12
# NOTIFY_EMAIL_PER_HOUR=12
# NOTIFY_EMAIL_PER_DAY=100
# NOTIFY_EMAIL_INSTANCE_PER_MINUTE=60
# NOTIFY_EMAIL_ACTIVE_WINDOW=5m

# The company that sends platform email, in each email's footer where the law asks for it
# (for example a UK company's name, number, place of registration and registered office).
# Unset shows no company.
# EMAIL_LEGAL_ENTITY=
# EMAIL_LEGAL_COMPANY_NUMBER=
# EMAIL_LEGAL_PLACE_OF_REGISTRATION=
# EMAIL_LEGAL_ADDRESS=

# Forwarding addresses: <token>@INBOUND_DOMAIN. POST /v1/inbound/email needs INBOUND_SECRET.
INBOUND_DOMAIN=in.localhost
INBOUND_SECRET=
INBOUND_SMTP_ADDR=
# STARTTLS for the built-in SMTP receiver (PEM files, read again when they change).
INBOUND_SMTP_TLS_CERT=
INBOUND_SMTP_TLS_KEY=
# Receiving servers whose Authentication-Results (DMARC) on inbound mail are believed,
# comma-separated authserv-ids. mx.cloudflare.net with the Cloudflare Email Worker. The
# built-in SMTP receiver adds none: there they count only for mail from a relay listed in
# INBOUND_SMTP_RELAYS (comma-separated IPs or CIDR ranges); other mail's results are unknown.
INBOUND_AUTHSERV_ID=
INBOUND_SMTP_RELAYS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gmail mailbox connections with their own Google client (another project); the
# sign-in client above when unset.
GOOGLE_MAILBOX_CLIENT_ID=
GOOGLE_MAILBOX_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# Microsoft mailbox connections with their own app; the sign-in app above when unset.
MICROSOFT_MAILBOX_CLIENT_ID=
MICROSOFT_MAILBOX_CLIENT_SECRET=
# Mailbox sign-in with Google or Microsoft, on by default when that provider's client
# is set. false hides it from the mailbox wizard and refuses new connections (mailboxes
# already connected that way keep working and can reconnect); people then connect with
# an app password over IMAP and SMTP, or forwarding. Signing in to opendesk is not affected.
GOOGLE_MAILBOX_OAUTH=
MICROSOFT_MAILBOX_OAUTH=
# Look up unknown mail domains in Thunderbird's ISPDB (autoconfig.thunderbird.net) when
# detecting a mailbox's servers. Off by default on a self-host, on with billing configured.
MAILHOST_ISPDB=
# Receive mail over IMAP: generic IMAP, and Google and Microsoft mailboxes that read
# their inbox. false means forwarding only: Google and Microsoft then connect to send
# replies, and no IMAP connection is kept open.
MAILBOX_IMAP=true
# Let mailboxes send replies through the platform mailer (MAIL_DRIVER, from MAIL_FROM).
# false means every mailbox sends through its own Google, Microsoft or SMTP server.
MAILBOX_SYSTEM_SEND=true
# Collab (contracts/collab.md): members connect their own mail accounts and use them in
# opendesk like a mail client, private or shared. On by default on a self-host (every
# workspace has it); with billing it is the collab plan's. The OAuth clients default to
# the mailbox clients above; register <API_URL>/v1/collab/accounts/oauth/google/callback
# and .../microsoft/callback with them. Google needs gmail.modify, Microsoft Graph
# Mail.ReadWrite and Mail.Send. COLLAB_IMAP offers accounts on any IMAP server.
COLLAB=true
COLLAB_IMAP=true
COLLAB_GOOGLE_CLIENT_ID=
COLLAB_GOOGLE_CLIENT_SECRET=
COLLAB_MICROSOFT_CLIENT_ID=
COLLAB_MICROSOFT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=SSO

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# --- Billing (opendesk Cloud only) ----------------------------------------------
# Leave STRIPE_SECRET_KEY empty on a self-hosted instance: no plans, no limits.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring per-seat price ($18/seat/month) and an optional yearly price.
STRIPE_PRICE_PRO=
STRIPE_PRICE_PRO_YEARLY=
# The hidden collab plan ($38/seat/month) and an optional yearly price. Only workspaces an
# instance admin offered it to can buy it (contracts/billing.md "Collab").
STRIPE_PRICE_COLLAB=
STRIPE_PRICE_COLLAB_YEARLY=
# One-time $10 price for an AI top-up ($10 of AI usage). STRIPE_PRICE_CREDITS is still read when this is unset.
STRIPE_PRICE_AI_TOPUP=
# Development only: point Stripe calls at a local fake or stripe-mock.
# STRIPE_API_URL=http://127.0.0.1:12111

# --- AI -----------------------------------------------------------------------------
# anthropic | openai (any OpenAI-compatible endpoint: OpenAI, Azure, Ollama, vLLM) | none.
# Detected from the keys below when empty.
AI_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Defaults with Anthropic: claude-sonnet-5-5 and claude-haiku-4-5-20251001.
AI_MODEL=
AI_FAST_MODEL=
# Semantic search: voyage | openai | none (Postgres full-text search).
EMBEDDINGS_DRIVER=
VOYAGE_API_KEY=
EMBEDDINGS_MODEL=
# Decisions (triage, answer bot relevance, ai_decide conditions): typesafe | llm | none.
# Detected when empty: typesafe with TYPESAFE_API_KEY, else llm with an AI provider, else none.
DECISIONS_PROVIDER=
# Jev by TypeSafe. Without a key, decisions use the AI provider's fast model.
TYPESAFE_API_KEY=
# Vercel AI Gateway: https://ai-gateway.vercel.sh/typesafe with TYPESAFE_MODEL=typesafe-ai/jev
TYPESAFE_API_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest
# Integrations: OAuth apps registered in advance, per product (MCP_<KEY>_CLIENT_ID / _SECRET).
MCP_SLACK_CLIENT_ID=
MCP_SLACK_CLIENT_SECRET=

# --- Native apps (contracts/native.md) --------------------------------------------
# iPhone push: an APNs key sends directly; without one, PUSH_RELAY_URL (e.g.
# https://api.opendesk.sh) sends through the relay; neither leaves push off.
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=sh.opendesk.app
PUSH_RELAY_URL=
# Cloud only: serve /v1/push/relay/* for self-hosted instances (needs an APNs key).
PUSH_RELAY_SERVE=false
# TEAMID.bundle app ids whose App Attest proofs stand in for Turnstile; empty = off.
APP_ATTEST_APP_IDS=
# Also accept development App Attest keys (debug builds from Xcode).
APP_ATTEST_DEVELOPMENT=false
