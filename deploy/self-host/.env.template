# opendesk self-host configuration, read by docker-compose.yml next to it.
#
# The installer (https://opendesk.sh/install.sh) writes this file with fresh
# secrets. From a checkout, `make selfhost-env` does the same. Either way the
# secrets are generated once and never regenerated: keep a copy of this file
# somewhere other than this machine.

# ── Release ────────────────────────────────────────────────────────────────
# Pinned, never "latest", so `docker compose up -d` always brings up the same
# version. Upgrade by changing it, then `docker compose pull && docker compose up -d`.
OPENDESK_VERSION=latest
# OPENDESK_IMAGE=ghcr.io/useopendesk/opendesk
# REALTIME_IMAGE=ghcr.io/useopendesk/realtime

# ── Updates ────────────────────────────────────────────────────────────────
# Install new releases each night: a systemd timer (or cron entry) runs
# `opendesk-ctl auto-update run`, which moves OPENDESK_VERSION to the newest
# release of the same major version. It backs up first, and goes back to the
# version before (and its database) when the new one does not come up healthy.
# Change it with `opendesk-ctl auto-update on|off`, which also adds or removes
# the schedule.
AUTO_UPDATE=true
# Look for new releases on GitHub (a plain request, nothing about this instance)
# and tell the instance admins in the admin panel and by email.
UPDATE_CHECK=true
# debug, info, warn or error. debug adds a line for every mailbox sync.
# LOG_LEVEL=info

# ── Address ────────────────────────────────────────────────────────────────
# The hostname people open. Its DNS must point at this machine, with ports 80
# and 443 reachable, for Caddy to get a certificate. "localhost" uses Caddy's
# local CA. Behind your own reverse proxy, see "Your own reverse proxy" below.
OPENDESK_DOMAIN=localhost
OPENDESK_URL=https://localhost
OPENDESK_GATEWAY_URL=wss://localhost/socket
# Caddy global options. Set an email so the ACME account can be reached about
# expiring certificates.
CADDY_GLOBAL_OPTIONS=
# HTTP_PORT=80
# HTTPS_PORT=443
# OPENDESK_CADDYFILE=./deploy/caddy/Caddyfile

# ── Your own reverse proxy (optional) ──────────────────────────────────────
# To put Traefik, nginx, Nginx Proxy Manager or a Caddy you already run in
# front instead of the bundled Caddy, add compose.external-proxy.yml (the
# installer's --proxy external does). The bundled Caddy then does not run, and
# OPENDESK_URL and OPENDESK_GATEWAY_URL are the https and wss addresses your
# proxy serves. Route /socket and /socket/* to realtime (WebSocket) and
# everything else to opendesk, with the Host header as is.
# Docs: https://docs.opendesk.sh/self-hosting/reverse-proxy/
# COMPOSE_FILE=docker-compose.yml:compose.external-proxy.yml
# Where opendesk (OPENDESK_PORT) and realtime (REALTIME_PORT) listen for the
# proxy, over plain HTTP. 127.0.0.1 is reachable from this host only; a proxy
# in a container can join the opendesk_proxy network instead.
# OPENDESK_BIND=127.0.0.1
# OPENDESK_PORT=8080
# REALTIME_PORT=4000
# Proxies in front that append to X-Forwarded-For: 1 for your proxy, 2 with
# Cloudflare (or a load balancer) in front of it. The client address for rate
# limits and the audit log is read that many entries from the right.
# TRUSTED_PROXY_HOPS=1

# ── Help centers ───────────────────────────────────────────────────────────
# Each brand's help center is a website of its own. Without HELP_DOMAIN it is at
# OPENDESK_URL/help/<slug>. With HELP_DOMAIN=help.example.com it is at
# https://<slug>.help.example.com: add a wildcard DNS record *.help.example.com
# (A/AAAA, or a CNAME to OPENDESK_DOMAIN) pointing at this host. There is no
# wildcard certificate to manage: Caddy gets each help center's certificate on
# its first visit, and only for help centers this instance has.
HELP_DOMAIN=
# Custom domains (help.acme.com) work out of the box: in the brand's settings,
# the customer adds a TXT record and a CNAME to this host, and the certificate
# is issued on the first visit once both are found. HELP_CNAME_TARGET is the
# CNAME they are shown; empty is the host of OPENDESK_URL.
HELP_CNAME_TARGET=

# ── Secrets (generated; never change them on a running install) ────────────
# Signs every session and realtime token; shared with the gateway. >= 32 bytes.
AUTH_SECRET=
# Encrypts mailbox credentials, OAuth tokens and webhook secrets (32 bytes hex).
# LOSING IT MAKES EVERY STORED MAILBOX CREDENTIAL UNREADABLE. Back it up.
CREDENTIALS_KEY=
# The gateway's Phoenix secret.
SECRET_KEY_BASE=
# Authenticates the gateway to the embedded NATS.
NATS_TOKEN=
# Authenticates POST /v1/inbound/email (forwarded mail from a relay or worker).
INBOUND_SECRET=
POSTGRES_PASSWORD=

# ── Accounts ───────────────────────────────────────────────────────────────
# After the first owner has signed up, set false to close registration.
SIGNUP_ENABLED=true

# ── Platform email (verification, password resets, invitations) ────────────
# log prints messages to `docker compose logs opendesk`; use smtp for real mail.
MAIL_DRIVER=log
MAIL_FROM=opendesk <notifications@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (587) | tls (465) | none
SMTP_TLS=starttls

# Notification email pacing. NOTIFY_EMAIL_PACING picks the defaults: strict (the default
# when billing is on: first email after 5m, then at most one every 15m, 30m, 1h; 4 an
# hour, 24 a day) or relaxed (self-hosted: 5m, 15m, 30m, 1h; 12 an hour, 100 a day).
# Urgent ones (mentions, missed SLAs, handoffs, billing problems) may come sooner.
# NOTIFY_EMAIL_PACING=relaxed
# NOTIFY_EMAIL_DELAY=5m
# NOTIFY_EMAIL_COOLDOWNS=5m,15m,30m,1h
# NOTIFY_EMAIL_QUIET_RESET=2h
# NOTIFY_EMAIL_URGENT_GAP=5m
# NOTIFY_EMAIL_URGENT_PER_DAY=12
# NOTIFY_EMAIL_PER_HOUR=12
# NOTIFY_EMAIL_PER_DAY=100
# NOTIFY_EMAIL_INSTANCE_PER_MINUTE=60
# NOTIFY_EMAIL_ACTIVE_WINDOW=5m

# The company that sends platform email, in each email's footer where the law asks for it
# (for example a UK company's name, number, place of registration and registered office).
# Unset shows no company.
# EMAIL_LEGAL_ENTITY=
# EMAIL_LEGAL_COMPANY_NUMBER=
# EMAIL_LEGAL_PLACE_OF_REGISTRATION=
# EMAIL_LEGAL_ADDRESS=

# ── Inbound email ──────────────────────────────────────────────────────────
# Forwarding addresses are <token>@INBOUND_DOMAIN. To receive mail directly,
# point an MX record for INBOUND_DOMAIN at this host, set INBOUND_SMTP_ADDR=:2525
# and add smtp-inbound to COMPOSE_PROFILES (publishes port INBOUND_SMTP_PORT, 25).
INBOUND_DOMAIN=in.localhost
INBOUND_SMTP_ADDR=
# INBOUND_SMTP_PORT=25
# Receiving servers whose Authentication-Results (DMARC) are believed, comma-separated:
# mx.cloudflare.net with the Cloudflare Email Worker. Leave empty with the built-in
# receiver, which does not check senders itself.
INBOUND_AUTHSERV_ID=

# ── Attachments ────────────────────────────────────────────────────────────
# local keeps files in the opendesk-data volume. s3 works with AWS S3,
# Cloudflare R2, or the bundled minio profile.
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ── Optional services ──────────────────────────────────────────────────────
# Comma separated: minio, smtp-inbound, ollama
COMPOSE_PROFILES=

# ── Sign-in providers and mailbox connections (optional) ───────────────────
# Redirect URIs to register with each provider (provider = google, microsoft, github, oidc):
#   sign-in:   https://<your domain>/v1/auth/oauth/<provider>/callback
#   mailboxes: https://<your domain>/v1/mailboxes/oauth/<provider>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# Mailbox connections with their own Google client or Microsoft app; the sign-in
# ones above when unset.
GOOGLE_MAILBOX_CLIENT_ID=
GOOGLE_MAILBOX_CLIENT_SECRET=
MICROSOFT_MAILBOX_CLIENT_ID=
MICROSOFT_MAILBOX_CLIENT_SECRET=
# Mailbox sign-in with Google or Microsoft, on by default when that provider's client
# is set. false hides it from the mailbox wizard and refuses new connections (mailboxes
# already connected that way keep working and can reconnect); people then connect with
# an app password over IMAP and SMTP, or forwarding. Signing in to opendesk is not affected.
GOOGLE_MAILBOX_OAUTH=
MICROSOFT_MAILBOX_OAUTH=
# Look up unknown mail domains in Thunderbird's ISPDB (autoconfig.thunderbird.net) when
# detecting a mailbox's servers. Off by default on a self-host, on with billing configured.
MAILHOST_ISPDB=
# Receive mail over IMAP: generic IMAP, and Google and Microsoft mailboxes that read
# their inbox. false means forwarding only: Google and Microsoft then connect to send
# replies, and no IMAP connection is kept open. With Collab on, generic IMAP stays
# available (set COLLAB_IMAP=false too), and Google and Microsoft mailboxes can read the
# inbox through their APIs with the Collab clients.
MAILBOX_IMAP=true
# Let mailboxes send replies through the platform mailer (MAIL_DRIVER, from MAIL_FROM).
# false means every mailbox sends through its own Google, Microsoft or SMTP server.
MAILBOX_SYSTEM_SEND=true
# Collab: members connect their own mail accounts (Google, Microsoft, IMAP) and use them
# in opendesk like a mail client, private or shared. The OAuth clients default to the
# mailbox clients; register <API_URL>/v1/collab/accounts/oauth/google/callback and
# .../microsoft/callback with them (Google: gmail.modify; Microsoft: Mail.ReadWrite, Mail.Send).
# Support mailboxes that read their inbox directly use them too: when they are separate
# clients, also register <API_URL>/v1/mailboxes/oauth/google/callback and .../microsoft/callback.
COLLAB=true
COLLAB_IMAP=true
COLLAB_GOOGLE_CLIENT_ID=
COLLAB_GOOGLE_CLIENT_SECRET=
COLLAB_MICROSOFT_CLIENT_ID=
COLLAB_MICROSOFT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=SSO

# ── AI (optional) ──────────────────────────────────────────────────────────
# No key = AI features off. Self-hosted instances have no plans or AI balance.
# anthropic | openai (any OpenAI-compatible endpoint: OpenAI, Azure, Ollama,
# vLLM, LM Studio) | none. Empty = detected from the keys below.
AI_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Empty = the provider's default models.
AI_MODEL=
AI_FAST_MODEL=
# Semantic search: voyage | openai | none (Postgres full-text search).
EMBEDDINGS_DRIVER=
VOYAGE_API_KEY=
EMBEDDINGS_MODEL=
# Decisions (triage, answer bot relevance, ai_decide conditions): typesafe |
# llm | none. Empty = typesafe with TYPESAFE_API_KEY, else llm, else none.
# Without a TypeSafe key every feature keeps working on the LLM path.
DECISIONS_PROVIDER=
TYPESAFE_API_KEY=
TYPESAFE_API_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest
# Fully local: add ollama to COMPOSE_PROFILES and set
#   AI_PROVIDER=openai  OPENAI_BASE_URL=http://ollama:11434/v1  OPENAI_API_KEY=ollama
#   AI_MODEL=llama3.1:8b  EMBEDDINGS_DRIVER=openai  EMBEDDINGS_MODEL=nomic-embed-text
# (or run the installer with --ollama). The models are pulled on first start.
# Integrations (Settings, Integrations). Most products sign in with no setup.
# Slack and Box only accept apps registered in advance: create one with the redirect
# URL <API_URL>/v1/integrations/oauth/callback and set its client here.
MCP_SLACK_CLIENT_ID=
MCP_SLACK_CLIENT_SECRET=
MCP_BOX_CLIENT_ID=
MCP_BOX_CLIENT_SECRET=
# GitHub signs in with a GitHub App when one is set (Issues read and write; Pull
# requests and Contents read), and asks for a token otherwise.
MCP_GITHUB_CLIENT_ID=
MCP_GITHUB_CLIENT_SECRET=

# ── Bot protection and product analytics (optional) ────────────────────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Server-side PostHog. Empty sends nothing anywhere.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Browser-side PostHog for the web app.
WEB_POSTHOG_KEY=
WEB_POSTHOG_HOST=

# ── iPhone app (optional) ──────────────────────────────────────────────────
# The desktop app and the iPhone app connect to this instance with nothing set
# here. Push notifications to iPhones are off until you choose one way:
#
# Relay: set https://api.opendesk.sh to send pushes through the opendesk relay,
# which sees this instance's address, the notification type and the ticket
# number, never ticket text, names or email addresses.
PUSH_RELAY_URL=
# Direct: your own APNs auth key (.p8). Apple only delivers it to an iPhone app
# signed by the same team, so this is for an app you build yourself. The key is
# the .p8 file base64-encoded on one line (base64 < AuthKey_XXXX.p8 | tr -d '\n'),
# or its PEM text in double quotes with \n between lines. The three APNS_KEY*
# values go together, and a key takes precedence over PUSH_RELAY_URL.
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=sh.opendesk.app
# With Turnstile on, the iPhone app proves itself with App Attest instead:
# comma-separated TEAMID.bundle app ids to accept. Empty turns App Attest off.
APP_ATTEST_APP_IDS=
