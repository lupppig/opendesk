# opendesk-app (app.opendesk.sh). Copied into web/dist by deploy.yml.
# Mirrors the headers the Go binary sets when it serves the same build
# (internal/webui and httpx.SecurityHeaders). Pages joins the values of every
# matching rule, so each header is set by exactly one rule per path.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://api.opendesk.sh wss://gateway.opendesk.sh https://*.posthog.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Content-hashed bundles never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The widget is loaded by customer sites, so it is cross-origin, never framed
# by policy here, and short-cached so a release reaches every site quickly.
/widget/*
  ! X-Frame-Options
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

# Written at deploy time by write-config.mjs. config.json is the same object
# for the desktop and iPhone apps (contracts/native.md).
/config.js
  Cache-Control: no-store

/config.json
  Cache-Control: no-store

# Written by write-config.mjs when APPLE_APP_IDS is set. The file has no
# extension, and Apple reads it only as JSON.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600
