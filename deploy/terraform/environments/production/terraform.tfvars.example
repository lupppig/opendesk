# Copy to terraform.tfvars (gitignored) and fill in.

cloudflare_account_id = "0123456789abcdef0123456789abcdef"
# cloudflare_zone_id  = "..."            # optional; looked up from cloudflare_zone_name otherwise

# Help centers at <slug>.<help_domain>; custom domains through Cloudflare for SaaS
# on that zone (deploy/README.md, "Help centers"). "" turns the help zone off.
# help_domain  = "opendeskhelp.com"
# help_zone_id = "..."                   # optional; looked up from help_domain otherwise

aws_region = "us-east-1"

# Create the database in the PlanetScale dashboard first: Postgres, AWS
# us-east-1 (same as aws_region), the size you want, single node or HA.
planetscale = {
  organization = "opendesk"
  database     = "opendesk"
  # branch     = "main"
}

# Launch sizes are the defaults (variables.tf, "Sizes"). For no single point of failure:
# api        = { min = 2, max = 6 }
# gateway    = { min = 2, max = 4 }
# worker     = { spot = false }
# nats_nodes = 3

github_repo = "useopendesk/opendesk"
# github_repo_immutable = "opendesk@123456/opendesk@7890123"   # when the repository uses immutable OIDC subjects
# create_github_oidc_provider       = false   # if the account already has it
# existing_github_oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"

google_client_id    = ""
# google_mailbox_client_id = ""   # Gmail mailboxes in their own Google project (secret GOOGLE_MAILBOX_CLIENT_SECRET)
# microsoft_mailbox_client_id = "" # Microsoft mailboxes in their own Entra app (secret MICROSOFT_MAILBOX_CLIENT_SECRET)
# collab_google_client_id = ""    # Collab mail accounts in their own Google project (gmail.modify; secret COLLAB_GOOGLE_CLIENT_SECRET)
# collab_microsoft_client_id = "" # Collab mail accounts in their own Entra app (secret COLLAB_MICROSOFT_CLIENT_SECRET)
microsoft_client_id = ""
github_client_id    = ""
turnstile_site_key  = ""
# Integrations that sign in with apps registered in advance (secrets MCP_SLACK_CLIENT_SECRET,
# MCP_BOX_CLIENT_SECRET, MCP_GITHUB_CLIENT_SECRET)
# mcp_slack_client_id  = ""
# mcp_box_client_id    = ""
# mcp_github_client_id = ""   # a GitHub App; empty asks for a token

# Mailbox sign-in per provider (user sign-in is not affected). Match the Pages
# variable MAILBOX_OAUTH so the wizard and the API agree.
google_mailbox_oauth    = false
microsoft_mailbox_oauth = true
# mailbox_imap = true   # also receive over IMAP; match the Pages variable MAILBOX_IMAP
# mailbox_system_send = true   # let mailboxes send replies through SES

# After `aws secretsmanager put-secret-value` for each:
# optional_secrets = [
#   "GOOGLE_CLIENT_SECRET", "MICROSOFT_CLIENT_SECRET", "TURNSTILE_SECRET", "POSTHOG_KEY",
#   # Billing (opendesk Cloud only): turns plans and limits on.
#   "STRIPE_SECRET_KEY", "STRIPE_WEBHOOK_SECRET", "STRIPE_PRICE_PRO", "STRIPE_PRICE_PRO_YEARLY", "STRIPE_PRICE_CREDITS",
#   # The hidden collab plan, and its own Google and Microsoft clients (collab_google_client_id, collab_microsoft_client_id).
#   "STRIPE_PRICE_COLLAB", "COLLAB_GOOGLE_CLIENT_SECRET", "COLLAB_MICROSOFT_CLIENT_SECRET",
#   # AI: OPENROUTER_API_KEY sets AI_PROVIDER=openrouter (chat, Jev and embeddings),
#   # else ANTHROPIC_API_KEY sets AI_PROVIDER=anthropic; VOYAGE_API_KEY sets EMBEDDINGS_DRIVER=voyage.
#   "OPENROUTER_API_KEY",
#   # iPhone push: the APNs auth key (.p8). Needs apns_key_id and apns_team_id.
#   "APNS_KEY",
#   # Help center custom domains: a token with SSL and Certificates edit on the
#   # help zone only. Sets CLOUDFLARE_SAAS_ZONE_ID to that zone.
#   "CLOUDFLARE_SAAS_TOKEN",
#   # Integrations: the Slack, Box and GitHub apps (with mcp_slack_client_id, mcp_box_client_id, mcp_github_client_id).
#   "MCP_SLACK_CLIENT_SECRET", "MCP_BOX_CLIENT_SECRET", "MCP_GITHUB_CLIENT_SECRET",
# ]
# Empty uses the app's default for the provider; ids are the provider's own.
# ai_model      = "anthropic/claude-sonnet-5.5"
# ai_fast_model = "anthropic/claude-haiku-5.5"

# Native apps (contracts/native.md).
# apns_key_id        = "ABC123DEFG"
# apns_team_id       = "ABCDE12345"
# apns_topic         = "sh.opendesk.app"
# push_relay_serve   = true             # relay pushes for self-hosted instances that opt in
# app_attest_app_ids = "ABCDE12345.sh.opendesk.app"

# nats_mode         = "external"           # Synadia Cloud or another managed NATS
# external_nats_url = "tls://connect.ngs.global"

# dmarc_rua = "team@opendesk.sh"
