---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import CodeTabs from '../components/CodeTabs.astro';
import CopyCommand from '../components/CopyCommand.astro';
import Faq from '../components/Faq.astro';
import Stage from '../components/Stage.astro';
import Backdrop from '../components/home/Backdrop.astro';
import HeroStage from '../components/home/HeroStage.astro';
import Bento from '../components/home/Bento.astro';
import Ollie from '../components/home/Ollie.astro';
import OllieShowcase from '../components/home/OllieShowcase.astro';
import AppsStage from '../components/home/AppsStage.astro';
import Tile from '../components/home/Tile.astro';
import { LINKS, SITE } from '../lib/site';
import { PRO_PRICE } from '../lib/pricing';
import PlanCards from '../components/PlanCards.astro';
import { CREATE_TICKET, WEBHOOK, REALTIME } from '../lib/samples';


const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'opendesk',
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: 'Help desk software',
  operatingSystem: 'Web, macOS, Windows, Linux, iOS',
  url: SITE.url,
  description: SITE.description,
  license: 'https://www.apache.org/licenses/LICENSE-2.0',
  codeRepository: LINKS.github,
  offers: [
    { '@type': 'Offer', name: 'Free', price: '0', priceCurrency: 'USD', description: '1 mailbox, 1 team member, every feature' },
    { '@type': 'Offer', name: 'Pro', price: String(PRO_PRICE), priceCurrency: 'USD', description: 'Per user per month, everything unlimited' },
    { '@type': 'Offer', name: 'Self-hosted', price: '0', priceCurrency: 'USD' },
  ],
};

const faq = [
  { q: 'Is opendesk really open source?', a: 'Yes. The code is Apache-2.0 licensed and developed in public on GitHub. opendesk Cloud runs the same code that is in the repository; there is no closed edition with extra features.' },
  { q: 'What is the difference between Cloud and self-hosted?', a: 'Only who runs it. Both have every feature. Cloud is free for one mailbox and one member, and $' + PRO_PRICE + ' per user a month for unlimited everything. Self-hosted is free and unlimited on your own servers, with your own AI key or a local model.' },
  { q: 'Which channels does it support?', a: 'Email forwarded from any provider, with replies sent from your own address through Gmail, Microsoft 365 or your SMTP server, plus a live chat widget for your site and a public help center. Everything arrives as tickets in one shared inbox.' },
  { q: 'Does the AI train on my customers’ messages?', a: 'No. Customer content is sent to the AI provider only to run the feature you asked for, and it is never used to train models. Admins can turn AI off for the whole workspace.' },
  { q: 'Can my customers write in their own language?', a: 'Yes. The widget and help center come in 14 languages, and messages and drafts translate both ways, so agents read and reply in their language while customers get theirs.' },
  { q: 'Can I move my data out?', a: 'Yes. Everything is available through the REST API, and self-hosted data sits in Postgres in a schema you can read. You can move from Cloud to your own servers on the same code.' },
];

const strip = [
  ['mail', 'Google Workspace'], ['mail', 'Microsoft 365'], ['server', 'SMTP'], ['at', 'Forwarding'],
  ['chat', 'Live chat'], ['book', 'Help center'], ['languages', '14 languages'], ['sparkles', 'Ollie'],
  ['plug', 'MCP tools'], ['braces', 'REST API'], ['webhook', 'Webhooks'], ['laptop', 'Desktop'], ['smartphone', 'iPhone'],
] as const;

const install = [
  ['·', 'Finding the newest release'],
  ['✓', 'Release files verified against SHA256SUMS'],
  ['✓', 'Wrote .env, docker-compose.yml and Caddyfile'],
  ['·', 'Pulling images'],
  ['✓', 'Containers started, migrations applied'],
  ['✓', 'opendesk is up'],
];
---
<Layout cta={{ command: true }} preload={{ name: 'roadside', sizes: '100vw' }} title="opendesk · The open-source helpdesk and team inbox" jsonLd={[softwareJsonLd, { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }]}>
  <!-- Hero: the app standing in a painted landscape. -->
  <section class="px-2 pt-2 md:px-3 md:pt-3" data-hero>
    <div class="relative isolate overflow-hidden rounded-[22px] md:rounded-[28px]">
      <div class="hero-sky absolute inset-x-0 -top-[6%] -z-10 h-[112%]">
        <Backdrop name="roadside" priority sizes="100vw" class="h-full w-full object-[50%_22%]" />
      </div>
      <div aria-hidden="true" class="absolute inset-0 -z-10 bg-[radial-gradient(70%_42%_at_50%_24%,rgb(16_46_116/0.55),transparent_75%),linear-gradient(180deg,rgb(16_46_116/0.6)_0%,rgb(16_46_116/0.32)_34%,transparent_58%)]"></div>

      <div class="container-page pt-16 text-center text-white md:pt-24">
        <a href={LINKS.github} class="group inline-flex h-8 items-center gap-2 rounded-full bg-white/12 pl-1 pr-3 text-[12.5px] text-white/90 ring-1 ring-white/25 backdrop-blur-md transition-colors hover:bg-white/20">
          <span class="inline-flex h-6 items-center gap-1.5 rounded-full bg-white px-2.5 text-[11.5px] font-medium text-[#0a0a0a]"><Icon name="github" size={11} />Apache-2.0</span>
          Cloud or your own servers
          <Icon name="arrowUpRight" size={12} class="text-white/60 transition-transform group-hover:-translate-y-px group-hover:translate-x-px" />
        </a>
        <h1 class="mx-auto mt-7 max-w-[15ch] text-balance text-[44px] lg:max-w-none font-semibold leading-[1] tracking-[-0.045em] [text-shadow:0_2px_30px_rgb(10_30_80/0.35)] sm:text-[68px] lg:text-[92px]">Every conversation, <br class="hidden sm:block" />shared with your team.</h1>
        <p class="mx-auto mt-6 max-w-[840px] text-balance text-[18px] leading-[1.5] text-white [text-shadow:0_1px_2px_rgb(10_30_80/0.35),0_2px_24px_rgb(10_30_80/0.5)] md:text-[22px]">
          Support email, live chat, your help center and your team's own mail accounts, in one inbox. Assign any conversation, talk it through together, and let Ollie draft the reply in any language.
        </p>
        <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a href={LINKS.signup} class="btn btn-lg bg-white text-[#0a0a0a] shadow-[0_10px_30px_-10px_rgb(10_30_80/0.5)] hover:bg-white/90">Start free<Icon name="arrowRight" size={15} /></a>
          <CopyCommand tone="inverse" class="!h-[46px] w-full max-w-[470px] !bg-white/10 text-left !ring-white/30 backdrop-blur-md sm:w-[470px]" />
        </div>
        <p class="mt-5 font-mono text-[11px] uppercase tracking-[0.08em] text-white/85 [text-shadow:0_1px_10px_rgb(10_30_80/0.6)]">Free for one mailbox · Self-hosted is free and unlimited</p>
      </div>

      <!-- Edges line up with the header: container-page, less the frame's own inset. -->
      <div class="hero-app relative mx-auto mt-14 max-w-[1416px] md:mt-20 md:px-7">
        <!-- Phones keep the window big and swipe across it. -->
        <div class="-mb-[150px] max-md:overflow-x-auto max-md:overflow-y-hidden max-md:overscroll-x-contain [scrollbar-width:none] md:-mb-[16%] [&::-webkit-scrollbar]:hidden">
          <div class="max-md:w-max max-md:px-3"><div class="max-md:w-[960px]"><HeroStage /></div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Everything it connects, moving. -->
  <section class="mt-10 md:mt-14" aria-label="Channels and platforms">
    <div class="marquee relative overflow-hidden">
      <div class="marquee-track flex w-max gap-2.5">
        {[...strip, ...strip].map(([i, l], k) => (
          <span class="flex h-10 items-center gap-2 rounded-full bg-surface-2 px-4 text-[13.5px] text-body ring-1 ring-line" aria-hidden={k >= strip.length ? 'true' : undefined}><Icon name={i as 'mail'} size={15} class="text-subtle" />{l}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Product -->
  <section id="product" class="container-page mt-24 md:mt-32">
    <div class="grid gap-6 lg:grid-cols-[1.1fr_1fr] lg:items-end">
      <div>
        <div class="label flex items-center gap-2"><span class="dot"></span>Product</div>
        <h2 class="mt-5 max-w-[16ch] text-[36px] font-semibold leading-[1.02] tracking-[-0.045em] text-fg md:text-[56px]">Everything support does, in one calm place.</h2>
      </div>
      <div class="lg:pb-2">
        <p class="lede max-w-[520px]">Email, chat and your help center become one queue of tickets, with the people, rules and targets that keep it moving. Nothing to stitch together.</p>
        <a href="/features/" class="link-arrow mt-5">See every feature<Icon name="arrowRight" size={14} /></a>
      </div>
    </div>
    <Bento />
  </section>

  <!-- Ollie -->
  <section id="ollie" class="container-page mt-28 scroll-mt-24 md:mt-40">
    <div class="flex flex-col items-center text-center">
      <div class="relative"><span class="ollie-glow" aria-hidden="true"></span><Ollie size={64} /></div>
      <div class="label mt-6 flex items-center gap-2 text-[var(--c-violet)]">AI teammate</div>
      <h2 class="mt-4 text-[36px] font-semibold leading-[1.02] tracking-[-0.045em] text-fg md:text-[56px]">Meet Ollie.</h2>
      <p class="lede mt-5 max-w-[620px]">It answers chats from your articles, drafts replies your team edits, works in the tools you connect and hands off the moment a person is needed. Everything it does is marked as Ollie.</p>
    </div>
    <div class="mt-12 md:mt-16"><OllieShowcase /></div>
    <div class="mt-6 flex flex-wrap items-center justify-between gap-4 px-1">
      <p class="text-[14px] text-muted">On Cloud you pay for <a href="/pricing/#ai-usage" class="text-fg underline decoration-line-strong underline-offset-4 hover:decoration-fg">AI usage</a> in dollars; self-hosted runs on your own key or a local model. Never used to train models.</p>
      <a href="/features/#ai" class="link-arrow">How opendesk uses AI<Icon name="arrowRight" size={14} /></a>
    </div>
  </section>

  <!-- Apps -->
  <section class="container-page mt-28 md:mt-40">
    <div class="grid gap-6 lg:grid-cols-[1.1fr_1fr] lg:items-end">
      <div>
        <div class="label flex items-center gap-2"><span class="dot"></span>Apps</div>
        <h2 class="mt-5 max-w-[15ch] text-[36px] font-semibold leading-[1.02] tracking-[-0.045em] text-fg md:text-[56px]">On your desk and in your pocket.</h2>
      </div>
      <div class="lg:pb-2">
        <p class="lede max-w-[520px]">A desktop app for Mac, Windows and Linux, and an iPhone app with push. Same inbox, same live updates, signed in to every workspace you work in.</p>
        <a href="/download/" class="link-arrow mt-5">Download the desktop app<Icon name="arrowRight" size={14} /></a>
      </div>
    </div>
    <div class="relative mt-12 overflow-hidden rounded-[22px] ring-1 ring-line md:mt-16">
      <Backdrop name="big-cloud" sizes="(min-width: 1440px) 1360px, 100vw" class="absolute inset-0 h-full w-full" />
      <AppsStage />
    </div>
    <div class="mt-3 grid gap-3 md:grid-cols-3">
      {[
        ['laptop', 'Desktop', 'A calm window of its own, with native notifications, a dock badge and every account a shortcut away.'],
        ['smartphone', 'iPhone', 'Push for new chats, replies and mentions, and the whole queue when you are away from your desk.'],
        ['keyboard', 'Keyboard first', 'Jump, assign, snooze and reply without the mouse. Press ? anywhere to see every shortcut.'],
      ].map(([i, t, d], k) => (
        <div class="rounded-[18px] bg-surface-2 p-6 ring-1 ring-line">
          <Icon name={i as 'laptop'} size={18} class="text-fg" />
          <h3 class="mt-4 text-[16px] font-semibold tracking-[-0.015em] text-fg">{t}</h3>
          <p class="mt-1.5 text-[14.5px] leading-relaxed text-muted">{d}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Open source and API -->
  <section class="container-page mt-28 md:mt-40">
    <div class="grid gap-6 lg:grid-cols-[1.1fr_1fr] lg:items-end">
      <div>
        <div class="label flex items-center gap-2"><span class="dot"></span>Open source</div>
        <h2 class="mt-5 max-w-[16ch] text-[36px] font-semibold leading-[1.02] tracking-[-0.045em] text-fg md:text-[56px]">Yours to read, run and change.</h2>
      </div>
      <p class="lede max-w-[520px] lg:pb-2">opendesk Cloud runs the code in the repository. Run the same thing on your own server with one command, and build on the API the app itself uses.</p>
    </div>
    <div class="mt-12 grid gap-3 md:mt-16 lg:grid-cols-12">
      <Tile class="lg:col-span-6" icon="terminal" title="Self-hosted in one command" body="One Go binary, the realtime gateway and Postgres behind Caddy, with HTTPS handled for you. No Redis, no Kafka." photo="golden-forest" href={LINKS.selfHostQuickstart}>
        <Stage w={600} h={400} tone="none" label="The opendesk installer running in a terminal.">
          <div class="absolute left-[36px] top-[36px] h-[328px] w-[528px] overflow-hidden rounded-[12px] bg-[#0a0a0a]/92 font-mono text-[12px] leading-[1.95] shadow-[0_40px_80px_-30px_rgb(60_30_0/0.6)] ring-1 ring-white/10 backdrop-blur" data-seq data-hold="4200">
            <div class="flex h-9 items-center gap-1.5 border-b border-white/10 px-4"><i class="size-2.5 rounded-full bg-[#ff5f57]"></i><i class="size-2.5 rounded-full bg-[#febc2e]"></i><i class="size-2.5 rounded-full bg-[#28c840]"></i><span class="ml-2 text-[10.5px] text-white/40">~/opendesk</span></div>
            <div class="p-5 text-left">
              <div class="flex gap-2"><span class="text-white/40">$</span><span class="s-fade text-white" data-step="1" data-wait="500" data-stream="60">curl -fsSL https://opendesk.sh/install.sh | sh</span></div>
              <div class="mt-2 text-white/60">
                {install.map(([m, t], i) => (
                  <div class="s-fade" data-step={i + 2} data-wait={i === 3 ? 1100 : 420}><span class={m === '✓' ? 'text-[#22c55e]' : 'text-white/35'}>{m}</span> {t}</div>
                ))}
                <div class="s-fade mt-3 text-white" data-step="8" data-wait="500">  Open https://desk.example.com<span class="od-caret !bg-white"></span></div>
              </div>
            </div>
          </div>
        </Stage>
      </Tile>
      <div class="tile flex flex-col rounded-[18px] bg-bg p-2 ring-1 ring-line lg:col-span-6">
        <div class="px-4 pb-5 pt-4 md:px-5 md:pt-5">
          <h3 class="flex items-center gap-2 text-[17px] font-semibold tracking-[-0.02em] text-fg"><Icon name="braces" size={16} class="text-subtle" />Built on the API you get</h3>
          <p class="mt-1.5 max-w-[46ch] text-[14.5px] leading-relaxed text-muted">Scoped keys, idempotent creates, signed webhooks and a realtime socket with replay. An OpenAPI 3.1 spec, generated from the server.</p>
        </div>
        <CodeTabs id="home-code" class="flex-1 !rounded-[12px] !shadow-none" tabs={[
          { label: 'Create a ticket', lang: 'bash', code: CREATE_TICKET },
          { label: 'Webhook', lang: 'http', code: WEBHOOK },
          { label: 'Realtime', lang: 'js', code: REALTIME },
        ]} />
      </div>
    </div>
    <div class="mt-3 grid grid-cols-2 gap-3 md:grid-cols-4">
      {[
        ['Apache-2.0', 'Read it, change it, run it anywhere.'],
        ['Same code', 'Cloud and self-hosted are one codebase.'],
        ['Postgres only', 'The one dependency. Your data stays in it.'],
        ['One command', 'Upgrades are a pull and a restart.'],
      ].map(([t, d], k) => (
        <div class="rounded-[18px] bg-surface-2 p-5 ring-1 ring-line md:p-6">
          <div class="text-[15px] font-semibold tracking-[-0.015em] text-fg">{t}</div>
          <div class="mt-1 text-[13.5px] leading-relaxed text-muted">{d}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- Pricing -->
  <section class="container-page mt-28 md:mt-40">
    <div class="flex flex-col items-center text-center">
      <div class="label flex items-center gap-2"><span class="dot"></span>Pricing</div>
      <h2 class="mt-5 text-[36px] font-semibold leading-[1.02] tracking-[-0.045em] text-fg md:text-[56px]">Free to start. One price to grow.</h2>
      <p class="lede mt-5 max-w-[540px]">Every feature on every plan, Ollie included. Plans differ only in limits.</p>
    </div>
    <PlanCards class="mt-12 md:mt-16" />
    <div class="mt-8 flex flex-wrap items-center justify-between gap-4 px-1">
      <p class="text-[14px] text-muted">Pro is billed per user who answers customers. Viewers are free.</p>
      <a href="/pricing/" class="link-arrow">Compare plans and AI pricing<Icon name="arrowRight" size={14} /></a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="container-page mt-28 md:mt-40">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.6fr]">
      <div>
        <div class="label flex items-center gap-2"><span class="dot"></span>Questions</div>
        <h2 class="mt-5 text-[36px] font-semibold leading-[1.02] tracking-[-0.045em] text-fg md:text-[48px]">Asked often.</h2>
        <p class="mt-4 max-w-[34ch] text-[15px] leading-relaxed text-muted">Something else? <a href="/contact/" class="text-fg underline decoration-line-strong underline-offset-4 hover:decoration-fg">Write to us</a>, a person answers.</p>
      </div>
      <Faq items={faq} />
    </div>
  </section>

</Layout>

<style is:global>
  .marquee { mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .marquee-track { animation: marquee 60s linear infinite; }
  .marquee:hover .marquee-track { animation-play-state: paused; }
  @keyframes marquee { to { transform: translateX(calc(-50% - 5px)); } }
  .ollie-glow { position: absolute; inset: -40px; border-radius: 99px; background: radial-gradient(closest-side, color-mix(in oklab, var(--c-violet) 22%, transparent), transparent); }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; }
  }
</style>

<script>
  import { initLive } from '../lib/live';
  initLive();

  // The sky drifts a little slower than the page.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const sky = hero?.querySelector<HTMLElement>('.hero-sky');
  if (hero && sky && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let raf = 0;
    const update = () => {
      raf = 0;
      const h = hero.offsetHeight;
      const y = Math.min(Math.max(window.scrollY, 0), h);
      sky.style.transform = `translate3d(0, ${y * 0.18}px, 0)`;
    };
    update();
    addEventListener('scroll', () => { raf ||= requestAnimationFrame(update); }, { passive: true });
    addEventListener('resize', () => { raf ||= requestAnimationFrame(update); });
  }
</script>
