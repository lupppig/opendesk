{
  "name": "@opendesk/qa",
  "private": true,
  "description": "QA for pull requests: the checks CI runs, for the areas a branch changes, on your machine",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "qa": "node scripts/qa.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test hooks/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "~7.0.2"
  }
}
